# Supabase — Content Builder
# Public read of the demo "brands" table. These are publishable/client keys,
# safe to expose in the browser. Copy to .env.local and set in Vercel project env.
#
# Without these, the app falls back to the bundled static brands and still works.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx_or_legacy_anon_jwt
